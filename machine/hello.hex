# Minimal ELF64 executable for Linux x86-64
# Prints "Hello, World!\n" via sys_write, then sys_exit(0)
#
# Layout:
#   0x0000  ELF header + program header
#   0x0078  machine code (_start)
#   0x009c  string "Hello, World!\n"

# ---- ELF64 header (64 bytes) ----
7f 45 4c 46          # e_ident: magic 0x7F 'E' 'L' 'F'
02                   # EI_CLASS: 64-bit
01                   # EI_DATA: little endian
01                   # EI_VERSION
00                   # EI_OSABI: System V
00 00 00 00 00 00 00 00  # padding
02 00                # e_type: ET_EXEC
3e 00                # e_machine: EM_X86_64
01 00 00 00          # e_version
78 00 40 00 00 00 00 00  # e_entry = 0x400078
40 00 00 00 00 00 00 00  # e_phoff = 64
00 00 00 00 00 00 00 00  # e_shoff
00 00 00 00          # e_flags
40 00                # e_ehsize = 64
38 00                # e_phentsize = 56
01 00                # e_phnum = 1
00 00                # e_shentsize
00 00                # e_shnum
00 00                # e_shstrndx

# ---- Program header (56 bytes) ----
01 00 00 00          # p_type: PT_LOAD
05 00 00 00          # p_flags: PF_R | PF_X
00 00 00 00 00 00 00 00  # p_offset
00 00 40 00 00 00 00 00  # p_vaddr = 0x400000
00 00 40 00 00 00 00 00  # p_paddr
aa 00 00 00 00 00 00 00  # p_filesz = 170
aa 00 00 00 00 00 00 00  # p_memsz  = 170
00 10 00 00 00 00 00 00  # p_align = 0x1000

# ---- Machine code at virtual address 0x400078 ----
# sys_write(1, msg, 14)
b8 01 00 00 00       # mov eax, 1          ; sys_write
bf 01 00 00 00       # mov edi, 1          ; fd = stdout
48 be 9c 00 40 00 00 00 00 00  # movabs rsi, 0x40009c  ; msg
ba 0e 00 00 00       # mov edx, 14         ; length
0f 05                # syscall

# sys_exit(0)
b8 3c 00 00 00       # mov eax, 60         ; sys_exit
31 ff                # xor edi, edi        ; status = 0
0f 05                # syscall

# ---- String at virtual address 0x40009c ----
48 65 6c 6c 6f 2c 20 57 6f 72 6c 64 21 0a  # "Hello, World!\n"
